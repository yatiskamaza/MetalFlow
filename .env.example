# Copie este archivo como .env y defina sus propios valores.
# El archivo .env está excluido del control de versiones (CT-07).

# La contraseña de SQL Server debe tener al menos 8 caracteres e incluir
# mayúsculas, minúsculas, dígitos y símbolos; de lo contrario el contenedor
# arranca y se detiene sin crear la instancia.
MSSQL_SA_PASSWORD=Cambie_Esta_Clave_2026!

# Cadena de conexión empleada por la API.
# Sustituya SU_CONTRASENA por el valor definido en MSSQL_SA_PASSWORD.
CONNECTION_STRING=Server=localhost,1433;Database=MetalFlowDb;User Id=sa;Password=SU_CONTRASENA;TrustServerCertificate=True

# Clave de firma de los tokens JWT (mínimo 32 caracteres).
# Genérela de forma aleatoria, por ejemplo con: openssl rand -base64 48
JWT_SECRET=genere_una_clave_aleatoria_de_al_menos_32_caracteres
JWT_ISSUER=MetalFlow
JWT_AUDIENCE=MetalFlowClientes
JWT_EXPIRACION_MINUTOS=120

# Credenciales de la cuenta de administrador de la plataforma.
# La cuenta se aprovisiona en el arranque de la aplicación a partir de estos
# valores; su derivación criptográfica se calcula en ese momento y no se
# versiona en forma alguna.
# La contraseña debe tener al menos 12 caracteres.
ADMINISTRADOR__EMAIL=admin@metalflow.local
ADMINISTRADOR__PASSWORD=defina_una_contrasena_robusta_de_12_caracteres_o_mas